<?xml version="1.0"?>
<model>
  <name>x500_rgb</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Ayaan Aatif</name>
    <email>munn33b@gmail.com</email>
  </author>

  <description>
    Quadrotor inspection drone matched to the client's physical airframe: a
    Holybro X500 V2 (500 mm wheelbase, ~1.3 kg all-up weight) carrying a
    nadir-mounted Raspberry Pi Camera Module 3 (standard, not Wide).

    The camera intrinsics are set from the real module's datasheet figures so
    that footage from this model is directly comparable to footage from the
    physical drone.
  </description>
</model>
