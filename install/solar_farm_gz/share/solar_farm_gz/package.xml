<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>solar_farm_gz</name>
  <version>0.1.0</version>
  <description>
    Procedurally generated photovoltaic solar farm world for Gazebo Harmonic
    and ROS 2 Jazzy, with randomised panel defects and ground-truth annotations
    for detector training.
  </description>
  <maintainer email="munn33b@gmail.com">Ayaan Aatif</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- teleop_joy: gamepad input and the MAVLink link to ArduPilot SITL -->
  <exec_depend>joy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="share/solar_farm_gz/worlds"/>
  </export>
</package>
